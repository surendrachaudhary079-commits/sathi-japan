{
  "headers": [
    {
      "source": "/(.*).ics",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/calendar; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "functions": {
    "api/remind.js": {
      "includeFiles": "areas.js"
    },
    "api/subscribe.js": {
      "includeFiles": "areas.js"
    }
  },
  "crons": [
    {
      "path": "/api/remind?hour=20",
      "schedule": "0 11 * * *"
    }
  ]
}